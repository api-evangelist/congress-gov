{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.congress.gov/schemas/parentcommittee",
  "title": "parentcommittee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "Judiciary Committee"
    },
    "systemCode": {
      "type": "string",
      "example": "hsju00"
    },
    "url": {
      "type": "string",
      "format": "url",
      "example": "https://api.congress.gov/v3/committee/house/hsju00?format=json"
    }
  }
}