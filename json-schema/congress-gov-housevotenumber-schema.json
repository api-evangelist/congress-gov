{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.congress.gov/schemas/HouseVoteNumber",
  "title": "HouseVoteNumber",
  "allOf": [
    {
      "$ref": "#/components/schemas/HouseVoteNumberBase"
    },
    {
      "type": "object",
      "properties": {
        "votePartyTotal": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/voteParty"
          }
        },
        "voteQuestion": {
          "type": "string",
          "example": "On Passage"
        }
      }
    }
  ]
}