{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.congress.gov/schemas/Congress",
  "title": "Congress",
  "type": "object",
  "properties": {
    "endYear": {
      "type": "string",
      "example": "2022"
    },
    "name": {
      "type": "string",
      "example": "117th Congress"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/Sessions"
      }
    },
    "startYear": {
      "type": "string",
      "example": "2021"
    }
  }
}