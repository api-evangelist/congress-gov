{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.congress.gov/schemas/senatecommittee",
  "title": "senatecommittee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "Armed Services Committee"
    },
    "systemCode": {
      "type": "string",
      "example": "ssas00"
    },
    "url": {
      "type": "string",
      "format": "url",
      "example": "https://api.congress.gov/v3/committee/senate/ssas00?format=json"
    }
  }
}