{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.congress.gov/schemas/witness",
  "title": "witness",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "The Honorable John Williams"
    },
    "organization": {
      "type": "string",
      "example": "United Auburn Rancheria"
    },
    "position": {
      "type": "string",
      "example": "Vice Chairman"
    }
  }
}